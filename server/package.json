{
  "name": "server",
  "version": "1.0.0",
  "description": "Sistema web para la gestión de equipos médicos y mobiliario del Hospital Regional de Huehuetenango \"Dr. Jorge Vides Molina\".",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "backup": "node backup.js create",
    "backup:list": "node backup.js list",
    "backup:restore": "node backup.js restore",
    "service:install": "node install-service.js",
    "service:uninstall": "node uninstall-service.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.2",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.6",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@libsql/client": "^0.15.15",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-windows": "^1.0.0-beta.8",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  }
}
